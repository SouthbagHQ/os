#!/bin/sh
# Root-owned lifecycle broker for the dedicated expander (input injection)
# worker. Owns the worker's inhibit state and stop barrier. There is NO
# activation path here on purpose.
#
# Why no start verb: starting the worker requires a one-shot protected
# authorization that only broker-owned verification of an account proof may
# create (see the reviewed control-path design). Caller uid equality, a
# customer-written note, a helper's exit code or IPC bytes are not that
# authority. Until a broker-owned verifier exists, every start/authorize
# verb is refused and the worker stays inhibited from boot. A partial
# broker that exposes activation without that authority must never ship.
#
# What unprivileged callers may do: request inhibit with the current
# generation. That can only stop and inhibit the worker - denial of service
# at worst, never activation. The session lock surface calls it before
# presenting any credential prompt: an OK return means the worker is
# stopped and its cgroup is empty.
set -eu
umask 077

UNIT=${SOUTHBAG_BROKER_UNIT:-southbag-espanso.service}
SYSTEMCTL=${SOUTHBAG_BROKER_SYSTEMCTL:-systemctl}
CGROUP_ROOT=${SOUTHBAG_BROKER_CGROUP_ROOT:-/sys/fs/cgroup}
STATE=${SOUTHBAG_BROKER_STATE:-/run/southbag-input-broker}
STOP_DEADLINE=${SOUTHBAG_BROKER_STOP_DEADLINE:-15}
# Test-only adapter; the image always uses the real default (root required).
ALLOW_NONROOT=${SOUTHBAG_BROKER_ALLOW_NONROOT:-0}

mkdir -p "$STATE"
chmod 700 "$STATE"

# State transitions are serialized through a root-owned lock.
exec 8>"$STATE/broker.lock"
flock -x 8

generation() { cat "$STATE/generation" 2>/dev/null || printf '0\n'; }
set_state() { printf '%s\n' "$1" >"$STATE/state"; }
get_state() { cat "$STATE/state" 2>/dev/null || printf 'inhibited\n'; }

# Three-state probe: 0 active, 1 known-inactive, 2 ADAPTER ERROR. Adapter
# errors (missing/unexecutable/broken systemctl) must never read as inactive:
# an unverifiable stop barrier fails closed.
unit_active() {
 "$SYSTEMCTL" is-active --quiet "$UNIT" >/dev/null 2>&1
 rc=$?
 case $rc in
  0) return 0 ;;
  1|3|4) return 1 ;;
  *) return 2 ;;
 esac
}

# Stop barrier: inhibit before anything that may fail. A failed stop never
# authorizes a credential prompt, a start, or a silent retry: state=failed
# until a later barrier proves the worker stopped and its cgroup empty.
stop_barrier() {
 set_state stopping
 unit_active && arc=0 || arc=$?
 if [ "$arc" = 2 ]; then set_state failed; return 1; fi
 if [ "$arc" = 0 ]; then
  # 8>&- : the backgrounded stop (and anything it orphans) must not inherit
  # the broker lock, or a killed stopper would hold the flock for its whole
  # lifetime and wedge the next transition behind it.
  "$SYSTEMCTL" stop "$UNIT" 8>&- >/dev/null 2>&1 &
  stopper=$!
  n=0
  while :; do
   unit_active && arc=0 || arc=$?
   if [ "$arc" = 2 ]; then
    kill "$stopper" 2>/dev/null || true
    set_state failed
    return 1
   fi
   [ "$arc" = 1 ] && break
   n=$((n+1))
   if [ "$n" -ge $((STOP_DEADLINE*10)) ]; then
    kill "$stopper" 2>/dev/null || true
    set_state failed
    return 1
   fi
   sleep .1
  done
  wait "$stopper" 2>/dev/null || true
 fi
 # API status alone is not enough: no tracked writer may remain. An
 # unverifiable cgroup read fails closed like a populated one.
 cg=$("$SYSTEMCTL" show "$UNIT" --property=ControlGroup --value 2>/dev/null) || { set_state failed; return 1; }
 if [ -n "$cg" ] && [ -r "$CGROUP_ROOT$cg/cgroup.events" ]; then
  if grep -q '^populated 1$' "$CGROUP_ROOT$cg/cgroup.events"; then
   set_state failed
   return 1
  fi
 fi
 set_state inhibited
 return 0
}

want_gen() {
 cur=$(generation)
 [ -n "${2:-}" ] && [ "$2" = "$cur" ] && [ "$cur" != 0 ] && return 0
 echo "stale or unknown generation" >&2
 exit 1
}

case "${1:-}" in
 begin-generation)
  # Root-owned lifecycle authority only; no public generation setter.
  [ "$ALLOW_NONROOT" = 1 ] || [ "$(id -u)" = 0 ] || { echo "begin-generation is root-only" >&2; exit 1; }
  stop_barrier
  g=$(generation)
  g=$((g+1))
  printf '%s\n' "$g" >"$STATE/generation"
  printf '%s\n' "$g"
  ;;
 inhibit)
  # OK return is the prerequisite for presenting a credential prompt.
  want_gen "$@"
  stop_barrier
  ;;
 current)
  # Read-only view so unprivileged lifecycle callers can learn the current
  # generation before inhibiting. No transition, no authority.
  printf 'generation=%s state=%s\n' "$(generation)" "$(get_state)"
  ;;
 status)
  want_gen "$@"
  printf 'generation=%s state=%s\n' "$(generation)" "$(get_state)"
  ;;
 *)
  # Deliberately no start/authorize-unlock verb: no protected auth
  # authority exists to grant one.
  echo "usage: southbag-input-broker begin-generation|inhibit GEN|status GEN|current" >&2
  exit 2
  ;;
esac
