#!/usr/bin/python3
"""Fresh, fail-closed self-status. No shared secret, token argv, cache or diagnostics."""
import json
import os
from pathlib import Path
import re
import stat
import sys
import time
import urllib.request


def private(path, owner):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != owner or st.st_mode & 0o077 or st.st_size > 16384:
            raise ValueError('invalid private state')
        return f.read()


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        # Never forward the user's bearer to another origin, even on 307/308.
        raise ValueError('redirect refused')


def check(root):
    root = Path(root)
    owner = root.lstat().st_uid
    if owner != os.getuid() and os.geteuid() != 0:
        raise ValueError('foreign state')
    generation = private(root / 'generation', owner).strip()
    account = private(root.parent / 'account', owner).split('\t')[0]
    session = json.loads(private(root / 'browser-session.json', owner))
    token = session.get('accessToken')
    expires = session.get('expiresAt')
    if (not generation or not account or session.get('generation') != generation or
            session.get('subject') != account or not isinstance(token, str) or
            not re.fullmatch(r'[A-Za-z0-9._~-]{20,8192}', token) or
            type(expires) not in (float, int) or not time.time()*1000 < expires <= (time.time()+86400)*1000):
        raise ValueError('invalid session')
    # Test-only origin adapter. Production never sets it.
    origin = os.environ.get('SOUTHBAG_IDENTITY_ORIGIN', 'https://identity.southbag.cc')
    req = urllib.request.Request(origin + '/api/account/status', headers={
        'Authorization': 'Bearer ' + token, 'Accept': 'application/json', 'Cache-Control': 'no-cache'})
    with urllib.request.build_opener(NoRedirect).open(req, timeout=8) as response:
        if response.status != 200:
            raise ValueError('status refused')
        body = response.read(16385)
        if len(body) > 16384:
            raise ValueError('oversized status')
        result = json.loads(body)
    if result.get('sub') != account or result.get('frozen') is not False:
        raise ValueError('account unavailable')


if __name__ == '__main__':
    try:
        check(sys.argv[1])
    except Exception:
        sys.exit(1)
