#!/bin/sh
# Starts the shell, and the service that lets it open app windows.
#
# Both run inside the Wayland session rather than as system services, so that
# every app process the launcher starts inherits the session's display and
# seat. Run as root outside the session, they would have neither.
set -eu

# Serves the shell, and the launcher endpoint under /cgi-bin. Loopback only.
# http rather than file:// because WebKit treats file:// as an opaque origin
# and fonts and fetches fail there.
/bin/busybox httpd -p 127.0.0.1:8080 -h /usr/share/southbag-shell

exec /usr/bin/cog \
  --gapplication-app-id=cc.southbag.shell \
  --platform=wayland \
  --bg-color=#050608 \
  http://127.0.0.1:8080/
