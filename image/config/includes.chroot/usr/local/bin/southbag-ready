#!/bin/sh
# Reports what actually came up, on the console.
#
# Useful on real hardware, and it is what the CI smoke boot greps for. It
# checks the session as well as the assets: a check that only proved the file
# server was running would pass with a dead compositor, which is precisely the
# failure worth catching.
set -u

wait_for() {
  i=0
  while [ "$i" -lt "$2" ]; do
    if $1; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

assets_up() { busybox wget -T 3 -q -O /dev/null http://127.0.0.1:8080/index.html; }
compositor_up() { busybox pidof labwc >/dev/null 2>&1; }
shell_up() { busybox pidof cog >/dev/null 2>&1; }

# The asset server now starts inside the session rather than as a system
# service, so it comes up after the compositor rather than before it.
if wait_for compositor_up 90; then
  echo "SOUTHBAG-OS-COMPOSITOR-OK" > /dev/console
else
  echo "SOUTHBAG-OS-COMPOSITOR-FAILED" > /dev/console
  {
    echo "--- session log ---"
    cat /home/customer/session.log 2>/dev/null || echo "(no session log: autologin may not have run)"
    echo "--- end ---"
  } > /dev/console 2>&1 || true
  exit 1
fi

if wait_for assets_up 60; then
  echo "SOUTHBAG-OS-ASSETS-OK" > /dev/console
else
  echo "SOUTHBAG-OS-ASSETS-FAILED" > /dev/console
  exit 1
fi

if wait_for shell_up 60; then
  echo "SOUTHBAG-OS-READY" > /dev/console
else
  echo "SOUTHBAG-OS-SHELL-FAILED" > /dev/console
  exit 1
fi

# An early process marker is not sustained runtime health. Require the same
# compositor and shell and working assets for a minute, then keep watching.
# This runs as the system readiness service, unlike the customer's session
# script, so console markers are writable and visible to the boot verifier.
compositor=$(busybox pidof labwc)
shell=$(busybox pidof cog)
[ -n "$compositor" ] && [ -n "$shell" ] || {
  echo 'SOUTHBAG-OS-UNSTABLE' > /dev/console
  exit 1
}
i=0
while :; do
  sleep 1
  if [ "$(busybox pidof labwc)" != "$compositor" ] ||
     [ "$(busybox pidof cog)" != "$shell" ] || ! assets_up; then
    echo 'SOUTHBAG-OS-UNSTABLE' > /dev/console
    exit 1
  fi
  i=$((i + 1))
  if [ "$i" -eq 60 ]; then
    echo 'SOUTHBAG-OS-STABLE' > /dev/console
  fi
done
