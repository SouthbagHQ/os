#!/usr/bin/python3
"""Prepare a private, generation-bound Browser handoff. Never log its contents."""
import json
import os
from pathlib import Path
import sqlite3
import stat
import sys
import tempfile
import time


def read_private(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd) as stream:
        st = os.fstat(stream.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077 or st.st_size > 65536:
            raise ValueError('untrusted session file')
        return stream.read()


def prepare(root):
    root = Path(root)
    generation = read_private(root / 'generation').strip()
    session = json.loads(read_private(root / 'browser-session.json'))
    subject = (root.parent / 'account').read_text().split('\t')[0]
    now = time.time()
    if (not generation or session.get('generation') != generation or session.get('subject') != subject
            or not isinstance(session.get('expiresAt'), (int, float))
            or not now * 1000 < session['expiresAt'] <= (now + 86400) * 1000):
        raise ValueError('expired or retired session')
    jar = root / 'identity-cookies.sqlite'
    st = jar.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise ValueError('untrusted cookie jar')
    # SQLite read-only takes a coherent snapshot including the live WAL, without
    # modifying WPE's jar. Only the secure Identity session cookie is exported.
    db = sqlite3.connect(f'{jar.as_uri()}?mode=ro', uri=True)
    try:
        rows = db.execute('SELECT name,value,host,path,expiry,isSecure,isHttpOnly FROM moz_cookies').fetchall()
    finally:
        db.close()
    cookies = []
    for name, value, host, path, expiry, secure, http_only in rows:
        if (host in ('southbag.cc', '.southbag.cc', 'identity.southbag.cc')
                and name in ('__Secure-better-auth.session_token', 'better-auth.session_token')
                and path == '/' and secure and http_only and (not expiry or expiry > now)):
            cookie = dict(name=name, value=value, domain=host, path=path, secure=True, httpOnly=True)
            if expiry:
                cookie['expirationDate'] = expiry
            cookies.append(cookie)
    if not cookies:
        raise ValueError('Identity session cookie unavailable')
    session['cookies'] = cookies
    fd, temp = tempfile.mkstemp(prefix='.browser-handoff-', dir=root)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(session, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, root / 'browser-handoff.json')
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


if __name__ == '__main__':
    try:
        prepare(sys.argv[1])
    except Exception:
        # No tokens, cookies, file contents or server responses in diagnostics.
        print('Southbag Browser: device sign-in handoff unavailable. Sign in to the OS again.', file=sys.stderr)
        sys.exit(1)
