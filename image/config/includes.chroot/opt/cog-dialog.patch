+    CogScriptDialog *dialog;
+    struct wl_surface *wl_surface;
+    struct xdg_surface *xdg_surface;
+    struct xdg_popup *xdg_popup;
+    struct xdg_positioner *xdg_positioner;
+    struct wl_shell_surface *shell_surface;
+} script_dialog_data = { 0, };
+static GQueue *pending_script_dialogs = NULL;
+static guint script_dialog_modal_hold_source = 0;
+static void create_script_dialog_popup(WebKitScriptDialog *dialog);
+static void destroy_script_dialog_popup(void);
+static void display_script_dialog_popup(void);
+static void script_dialog_modal_hold_start(void);
+static void script_dialog_modal_hold_cancel(void);
+
 
