+/*
+ * cog-script-dialog-wl.h
+ * Southbag: rendered, actionable script dialogs for the wayland platform.
+ * Modeled on cog-popup-menu-wl (same shm + cairo machinery).
+ * Distributed under terms of the MIT license, as the rest of cog.
+ */
+
+#ifndef COG_SCRIPT_DIALOG_WL_H
+#define COG_SCRIPT_DIALOG_WL_H
+
+#include <wayland-client.h>
+#include <wpe/webkit.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct _CogScriptDialog CogScriptDialog;
+
+/* Takes its own ref on dialog. scale is the output buffer scale. */
+CogScriptDialog *cog_script_dialog_create(WebKitScriptDialog *dialog,
+                                          struct wl_shm *shm,
+                                          int scale);
+void cog_script_dialog_destroy(CogScriptDialog *sd);
+
+int cog_script_dialog_get_width(CogScriptDialog *sd);
+int cog_script_dialog_get_height(CogScriptDialog *sd);
+
+/* Paints (idempotent) and returns the buffer to attach. */
+struct wl_buffer *cog_script_dialog_get_buffer(CogScriptDialog *sd);
+
+/* Pointer press at surface-local coordinates. Returns true when the press
+ * activated a button and the dialog answered itself. */
+bool cog_script_dialog_handle_pointer_press(CogScriptDialog *sd, int x, int y);
+
+/* Keysym (xkb) on a pressed key. Returns true when the key answered the
+ * dialog (Return activates, Escape cancels where a cancel exists). */
+bool cog_script_dialog_handle_key(CogScriptDialog *sd, uint32_t keysym);
+
+#endif /* COG_SCRIPT_DIALOG_WL_H */
