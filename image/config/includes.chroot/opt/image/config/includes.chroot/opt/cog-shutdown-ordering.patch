+/* The WebKitWebViewBackend owns the exportable through this destroy notify
+ * and tears it down when the web view goes away; the WebKit-side client
+ * bundle dies with it. Clear the platform-global reference first, so that
+ * no buffer or image release dispatched later during platform teardown
+ * (clear_buffers() in cog_wl_platform_finalize(), compositor buffer
+ * releases, frame callbacks) can dereference the dead client bundle: its
+ * heap pages may already be unmapped, which manifested as a SIGSEGV in
+ * ClientBundleEGL::releaseShmBuffer on every plain process termination. */
+static void
+on_wk_view_backend_destroyed(gpointer data)
+{
+    g_assert(data == wpe_host_data.exportable);
+    wpe_host_data.exportable = NULL;
+    wpe_view_backend_exportable_fdo_destroy(data);
+}
