[Unit]
Description=Southbag shell assets
Documentation=https://github.com/SouthbagHQ/os
Before=getty@tty1.service
After=local-fs.target

[Service]
# Loopback only. Serving the shell over http rather than file:// gives it
# ordinary origin semantics, which WebKit requires for fonts and fetches.
ExecStart=/bin/busybox httpd -f -v -p 127.0.0.1:8080 -h /usr/share/southbag-shell
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
