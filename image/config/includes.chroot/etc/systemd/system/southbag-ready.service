[Unit]
Description=Southbag OS readiness marker
# The session brings up the compositor and the asset server; this only
# watches for them and reports on the console.
After=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/southbag-ready
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
