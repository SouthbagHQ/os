<?xml version="1.0"?>
<!--
  labwc owns compositing, input and window geometry.

  The shell is a single fullscreen cog window with no decoration. cog cannot
  be a layer-shell client — its Wayland platform speaks xdg_shell only — so
  fullscreen is imposed here rather than requested by the client.
-->
<labwc_config>
  <core>
    <!--
      Apps are ordinary windows and get decoration. The shell is not, and is
      overridden below.
    -->
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>

  <windowRules>
    <!--
      The shell is the desktop: fullscreen, undecorated, underneath
      everything, and absent from the window switcher. It is not a window the
      customer is meant to think of as a window.
    -->
    <windowRule identifier="cc.southbag.shell" serverDecoration="no">
      <skipTaskbar>yes</skipTaskbar>
      <skipWindowSwitcher>yes</skipWindowSwitcher>
      <action name="ToggleFullscreen" />
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>

  <keyboard>
    <!--
      No compositor keybindings. Every shortcut belongs to the shell, so that
      the browser build and the device agree on what the keyboard does.
    -->
  </keyboard>
</labwc_config>
