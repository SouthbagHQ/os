<?xml version="1.0"?>
<!--
  labwc owns compositing, input and window geometry.

  The shell is a single fullscreen cog window with no decoration. cog cannot
  be a layer-shell client — its Wayland platform speaks xdg_shell only — so
  fullscreen is imposed here rather than requested by the client.
-->
<labwc_config>
  <core>
    <!--
      Apps are ordinary windows and get decoration. The shell is not, and is
      overridden below.
    -->
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>

  <windowRules>
    <!--
      The shell is the desktop: fullscreen, undecorated, underneath
      everything, and absent from the window switcher. It is not a window the
      customer is meant to think of as a window.
    -->
    <windowRule identifier="cc.southbag.shell" serverDecoration="no">
      <skipTaskbar>yes</skipTaskbar>
      <skipWindowSwitcher>yes</skipWindowSwitcher>
      <action name="ToggleFullscreen" />
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>

  <keyboard>
    <!-- Hardware volume keys belong to the compositor, not a web page:
         they must keep working with any service or browser window focused.
         Fixed mixer commands run as customer (audio group), with no OSD.
         Other shortcuts remain owned by the shell. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="amixer -q set Master 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="amixer -q set Master 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="amixer -q set Master toggle" />
    </keybind>
  </keyboard>
</labwc_config>
