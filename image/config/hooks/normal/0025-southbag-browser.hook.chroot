#!/bin/sh
# Installs the standalone Southbag Browser, but only when the build pins a
# version (image/build.sh writes /etc/default/southbag-browser). With the
# browser installed, cgi-bin/launch opens website apps as its app windows —
# real top-level windows on the full browser stack — and the Browser app is
# the whole browser. Without a pin the image keeps the cog path and this
# hook does nothing.
#
# The pin must be the first release that contains app windows (`--app=`).
# v1.0.0 predates them: installing it would make cgi-bin/launch open plain
# windows, not app windows. The .deb and SHA256SUMS.txt come from the
# pinned release on GitHub, and the checksum is verified before install.
set -eu

version=""
[ -f /etc/default/southbag-browser ] && version=$(cat /etc/default/southbag-browser)
if [ -z "$version" ]; then
  echo "southbag-browser: no version pinned, image stays on cog"
  exit 0
fi

deb="southbag-browser-${version#v}-linux-amd64.deb"
base="https://github.com/SouthbagHQ/browser/releases/download/$version"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends curl ca-certificates

cd /tmp
curl -fsSLO "$base/$deb"
curl -fsSLO "$base/SHA256SUMS.txt"
grep "  $deb\$" SHA256SUMS.txt | sha256sum -c -
apt-get install -y "/tmp/$deb"
rm -f "/tmp/$deb" SHA256SUMS.txt

# labwc is Wayland-only and the image has no XWayland: go through ozone.
cat > /usr/local/bin/southbag-browser <<'WRAP'
#!/bin/sh
exec /usr/bin/southbag-browser --ozone-platform=wayland "$@"
WRAP
chmod +x /usr/local/bin/southbag-browser
