#!/bin/sh
# LOCAL TEST ONLY: reproducible Browser source 8ce4382, not a release pin.
set -eu
export DEBIAN_FRONTEND=noninteractive
cd /opt/southbag-build-test
sha256sum -c SHA256SUMS
apt-get install -y --no-install-recommends ./southbag-browser-1.0.0-linux-amd64.deb
cat > /usr/local/bin/southbag-browser <<'WRAP'
#!/bin/sh
exec /usr/bin/southbag-browser --ozone-platform=wayland "$@"
WRAP
chmod 755 /usr/local/bin/southbag-browser
rm -rf /opt/southbag-build-test
