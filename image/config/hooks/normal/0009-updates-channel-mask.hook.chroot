#!/bin/sh
# Build-time safety mask for the Southbag update channel. The channel is
# activation-gated: until the signed Pages repository exists, its Release
# file 404s, and ANY hook's apt-get update then fails hard and kills the
# whole image build (first seen in 0016, then 0022). Mask the sources entry
# through all build-time apt refreshes. Hook 0026 stages the source for a
# root-owned boot unit, before the apt timers, only with the archive key.
set -eu

sources=/etc/apt/sources.list.d/southbag.sources

if [ -f "$sources" ]; then
  mv "$sources" /root/.southbag.sources.buildmask
  echo "southbag-updates: channel masked for the build (0026 restores/decides)."
fi
