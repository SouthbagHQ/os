#!/bin/sh
# GRUB has to talk to the serial port, and it has to stop waiting.
#
# Left alone, live-build's GRUB writes its menu to a video console and waits
# for a keypress. On a headless machine that is an indefinite hang with no
# output at all, which is exactly how this failed: UEFI handed off to GRUB and
# nothing was ever heard again.
#
# It is also wrong for the product. The device is not supposed to show a menu.
set -eu

for cfg in $(find binary -name grub.cfg 2>/dev/null); do
  cat >> "$cfg" <<'GRUB'

# Southbag: speak on the serial port as well as the screen, and boot.
serial --unit=0 --speed=115200
terminal_input --append serial
terminal_output --append serial
set timeout=5
set timeout_style=menu
GRUB
  echo "patched $cfg"
done
