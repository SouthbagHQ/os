#!/bin/sh
# Dedicated no-login identity. Never share customer/seat/input access.
set -eu
check_existing=false
case "${1:-}" in install|upgrade|--check-existing) check_existing=true ;; esac
if ! getent passwd southbag-inject >/dev/null; then
 [ "$check_existing" = false ] || exit 0
 adduser --system --group --home /var/lib/southbag-inject --no-create-home --disabled-password --shell /usr/sbin/nologin --gecos "" southbag-inject
fi
uid=$(id -u southbag-inject)
gid=$(id -g southbag-inject)
customer_uid=$(id -u customer)
customer_gid=$(id -g customer)
if ! { [ "$uid" -gt 0 ] && [ "$uid" -lt 1000 ]; }; then
 echo "Refusing non-system worker uid" >&2; exit 1
fi
if ! { [ "$gid" -gt 0 ] && [ "$gid" -lt 1000 ]; }; then
 echo "Refusing non-system worker gid" >&2; exit 1
fi
if [ "$uid" = "$customer_uid" ] || [ "$gid" = "$customer_gid" ]; then
 echo "Refusing shared customer identity" >&2; exit 1
fi
[ "$(getent passwd southbag-inject | cut -d: -f6)" = /var/lib/southbag-inject ]
[ "$(getent passwd southbag-inject | cut -d: -f7)" = /usr/sbin/nologin ]
[ "$(id -Gn southbag-inject)" = southbag-inject ]
[ "$check_existing" = false ] || exit 0
install -d -o root -g root -m 0755 /etc/southbag/espanso/packages
# No uinput chmod/group change, keyboard ownership change, module-load rule,
# event-device ACL, service enablement or input reader invocation.
