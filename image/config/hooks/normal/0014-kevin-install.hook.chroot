#!/bin/sh
# Normal-image worker activation follows account setup and exact package install.
set -eu
package=/tmp/southbag-kevin-candidate.deb
[ -f "$package" ] || exit 0
[ "$(sha256sum "$package" | cut -d' ' -f1)" = bdea3447ab3d0b69157cdf33d2ba8e014971973c114634a5ebf6803261071951 ] || { echo 'Unrecognized Kevin image input' >&2; exit 1; }
dpkg -i "$package"
rm -f "$package"
# Enable only for next boot, never start a device reader in the build chroot.
systemctl enable southbag-espanso-boot.service
