#!/bin/sh
# Build-time apt never sees the unpublished Southbag channel. Install its
# signed source before the apt timers at boot, not in a chroot hook: live-build
# refreshes apt again after ALL chroot hooks have finished.
set -eu

keyring=/usr/share/keyrings/southbag-archive-keyring.gpg
sources=/etc/apt/sources.list.d/southbag.sources
staged=/usr/share/southbag-updates/southbag.sources
unit=/etc/systemd/system/southbag-updates-channel.service

if [ -f /root/.southbag.sources.buildmask ]; then
  mkdir -p /usr/share/southbag-updates
  mv /root/.southbag.sources.buildmask "$staged"
fi
# Also cover direct hook qualification outside the complete hook sequence.
if [ -f "$sources" ]; then
  mkdir -p /usr/share/southbag-updates
  mv "$sources" "$staged"
fi

if [ ! -s "$keyring" ]; then
  echo 'southbag-updates: no archive keyring; Debian updates only.'
  rm -f "$staged" "$unit"
else
  test -s "$staged"
  cat > "$unit" <<'UNIT'
[Unit]
Description=Stage the signed Southbag update channel before apt
DefaultDependencies=no
After=local-fs.target
Before=timers.target apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service
ConditionPathExists=/usr/share/keyrings/southbag-archive-keyring.gpg
ConditionPathExists=/usr/share/southbag-updates/southbag.sources

[Service]
Type=oneshot
ExecStart=/usr/bin/install -m 644 /usr/share/southbag-updates/southbag.sources /etc/apt/sources.list.d/southbag.sources
RemainAfterExit=yes

[Install]
WantedBy=timers.target
UNIT
  systemctl enable southbag-updates-channel.service
  echo 'southbag-updates: signed source staged for boot before apt timers.'
fi
systemctl enable apt-daily.timer apt-daily-upgrade.timer
