# The whole operating system.
#
# Nothing is here for convenience. Every package costs boot time, memory and
# image size, and the target is a machine from 2013 with 2GB of RAM.

# Boot
live-boot
systemd-sysv
linux-image-amd64

# Session: a compositor, a browser engine, and seat access. That is all.
labwc
cog
seatd

# Serves the shell over loopback so it has ordinary web origin semantics
# rather than file://, which WebKit treats as opaque for fonts and fetches.
busybox

dbus

# Session lock: ext-session-lock client and the pieces it needs. swaylock is
# the compositor-enforced lock surface (labwc speaks ext-session-lock); the
# PAM helper re-auths online against Identity, parsed with jq rather than
# sed over field order. ca-certificates so its TLS verifies; one small font so the indicator can draw text (recommends are
# off image-wide, so nothing else pulls one in).
swaylock
jq
ca-certificates
fonts-dejavu-core

# Native lock client (southbag-lockd, built by the 0016 hook, dark behind
# /etc/southbag-lockd until proven on-device): cairo to draw the lock
# surface, libjpeg for the camera capture's YUYV fallback. libcairo2 comes
# with labwc already; named here so it cannot silently drop out.
libcairo2
libjpeg62-turbo

# Volume keys without a sound server: amixer sets the hardware mixer
# directly (/cgi-bin/volume), and libasound is what GStreamer audio falls
# back to in cog. No daemon, no mixer UI - adjustment is invisible by spec.
alsa-utils

# Daily security + Southbag repo upgrades, with the reboot window configured
# in includes.chroot/etc/apt/apt.conf.d/51southbag-updates.
unattended-upgrades
