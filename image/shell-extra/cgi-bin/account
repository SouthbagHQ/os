#!/bin/sh
# Records (or clears) which Southbag account this device belongs to, for the
# session lock's re-auth check. Written at login, cleared at logout.
#
# The note is authority - southbag-unlock lets in whoever it names - so it
# is never taken from the page's word:
#
# * Origin must be exactly the shell's own (http://127.0.0.1:8080). Service
#   sites open in app windows are other origins; browsers set Origin on
#   POST and a site cannot spoof it, so web content - the caller class this
#   boundary is for - cannot rebind the lock to an attacker's account.
#   (A process already running as the session user can signal swaylock
#   directly; that class is outside what the lock claims to stop.)
# * The identity recorded is what IDENTITY says: the bearer token posted
#   here is exchanged at the OAuth userinfo endpoint (token type, scope and
#   signature checked server-side by Identity) and the sub/email from that
#   answer are written, parsed with jq, never the caller's claim.
#
# Lives in the customer's home: ephemeral on a live boot (gone with the
# session), persistent on an installed system so a reboot cannot quietly
# drop the lock's account binding while the stored login lives on.
#
# Concurrency with the device-session manager: every write and clear here
# takes the same session.lock the manager holds for launch/reset/recovery,
# and is generation-fenced UNDER that lock. The caller names the era it
# belongs to (the generation the shell captured at login); a writer from a
# retired era is rejected, not merely delayed - after waiting out a reset's
# lock it finds the current generation changed or gone and is refused, so a
# stale sign-in completing during teardown can neither recreate the account
# note after reset removed it nor rebind the lock to a dead session.
#
# SOUTHBAG_IDENTITY_ORIGIN / SOUTHBAG_STATE_DIR / SOUTHBAG_WGET exist for
# the mock-contract tests (tests/account.test.mjs); the device never sets
# them.
set -eu

state=${SOUTHBAG_STATE_DIR:-"${HOME:-/home/customer}/.local/share/southbag"}
root="$state/device-session"
origin=${SOUTHBAG_IDENTITY_ORIGIN:-https://identity.southbag.cc}
wgetbin=${SOUTHBAG_WGET:-busybox wget}
navbin=${SOUTHBAG_NAV_STATE_BIN:-/usr/local/bin/southbag-nav-state}

fail() { printf 'Status: %s\r\nContent-Type: text/plain\r\n\r\n%s\r\n' "$1" "$2"; exit 0; }

[ "${HTTP_ORIGIN:-}" = "http://127.0.0.1:8080" ] || fail 403 "shell only"
[ "${REQUEST_METHOD:-}" = "POST" ] || fail 405 "post only"

len="${CONTENT_LENGTH:-0}"
[ "$len" -gt 0 ] && [ "$len" -lt 4096 ] || fail 400 "bad request"
body=$(dd bs=1 count="$len" 2>/dev/null)

mkdir -p "$state"
chmod 700 "$state"

posted=$(printf '%s' "$body" | jq -r '.generation // empty' 2>/dev/null)

if ! printf '%s' "$body" | jq -e '.clear == true' >/dev/null 2>&1; then
 # Token shape first: a malformed token never reaches a header.
 token=$(printf '%s' "$body" | jq -r '.accessToken // empty' 2>/dev/null)
 printf '%s' "$token" | grep -qE '^[A-Za-z0-9._~-]{20,}$' || fail 400 "no token"

 # The Identity exchange stays OUTSIDE the lock: network latency must not
 # hold up a reset. The era is re-checked under the lock at write time.
 # shellcheck disable=SC2086
 resp=$($wgetbin -q -T 8 -O - \
  --header "Authorization: Bearer $token" \
  "$origin/api/auth/oauth2/userinfo" 2>/dev/null) || {
   # Failure milestone, era-bound like the writes below: a refusal from a
   # retired era must not clobber a live era's journey phase. The exchange
   # itself stays outside the lock (network latency must not hold a reset).
   # The era check is made atomically against teardown under the session
   # lock, non-blocking: contention means a reset/launch is in flight, which
   # is exactly the case to skip. The 502 response is unchanged either way.
   (
    exec 8>"$state/session.lock"
    flock -n -x 8 || exit 0
    cur=$([ -f "$root/generation" ] && cat "$root/generation" || true)
    { [ -n "$posted" ] && [ -n "$cur" ] && [ "$posted" = "$cur" ]; } || exit 0
    "$navbin" binding_failed || true
   ) || true
   fail 502 "identity refused"
  }

 # This caller field is NOT an identity assertion or authorization. It is
 # only the callback's consistency fence against its verified ID-token sub.
 # A caller cannot bind an arbitrary subject: authority remains userinfo.
 expected=$(printf '%s' "$body" | jq -er '.expectedSubject | select(type == "string" and length > 0)' 2>/dev/null) || fail 400 "missing expected subject"
 sub=$(printf '%s' "$resp" | jq -r '.sub // empty' 2>/dev/null)
 email=$(printf '%s' "$resp" | jq -r '.email // empty' 2>/dev/null)
 { [ -n "$sub" ] && [ -n "$email" ]; } || fail 502 "identity answered without an account"
 [ "$sub" = "$expected" ] || fail 409 "identity subject mismatch"
fi

# Serialize with the manager, then fence: name a live era or be refused.
exec 9>"$state/session.lock"
flock -x 9
current=$([ -f "$root/generation" ] && cat "$root/generation" || true)
{ [ -n "$posted" ] && [ -n "$current" ] && [ "$posted" = "$current" ]; } || fail 409 "retired era"

if printf '%s' "$body" | jq -e '.clear == true' >/dev/null 2>&1; then
 /usr/local/bin/southbag-analytics account_cleared >/dev/null 2>&1 || true
 rm -f "$state/account" "$state/twofa-cookie" "$state/locked" "$root/browser-session.json" "$root/browser-handoff.json"
 "$navbin" account_cleared || true
 printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n{"recorded":false}'
 exit 0
fi

# Only the verified shell login may supply a Browser handoff. Old callers can
# still bind the lock, but must not leave stale credentials from an older login.
if printf '%s' "$body" | jq -e 'has("expiresAt")' >/dev/null 2>&1; then
 printf '%s' "$body" | jq -e '.expiresAt | type == "number" and . > (now * 1000) and . <= ((now + 86400) * 1000)' >/dev/null 2>&1 || fail 400 "invalid session expiry"
 ( umask 077; printf '%s' "$body" | jq -c --arg generation "$current" --arg subject "$sub" '{generation:$generation,subject:$subject,accessToken,expiresAt}' > "$root/.browser-session.tmp" ) || fail 500 "session handoff failed"
 mv -f "$root/.browser-session.tmp" "$root/browser-session.json" || fail 500 "session handoff failed"
else
 rm -f "$root/browser-session.json"
fi
rm -f "$root/browser-handoff.json"
( umask 077; printf '%s\t%s\n' "$sub" "$email" > "$state/account" )
"$navbin" account_bound || true
/usr/local/bin/southbag-analytics account_bound >/dev/null 2>&1 || true
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n{"recorded":true}'
