#!/bin/sh
# Host-test stand-in for the systemctl --user verbs southbag-device-session uses.
state=${FAKE_SYSTEMD_STATE:?}
cgroot=${SOUTHBAG_DEVICE_CGROUP_ROOT:?}
[ "${1:-}" = "--user" ] && shift
cmd=${1:-}; shift || true
unit=
for a in "$@"; do case "$a" in *.scope|*.service) unit=$a ;; esac; done
# Concurrent probes race a stop removing the pid file: read once, treat a
# vanished/empty file as inactive (never as a probe error).
pid_alive() {
 [ -f "$state/units/$1.pid" ] || return 1
 pid=$(cat "$state/units/$1.pid" 2>/dev/null) || return 1
 [ -n "$pid" ] || return 1
 kill -0 "$pid" 2>/dev/null
}
case "$cmd" in
 show)
  if [ -f "$state/units/$unit.pid" ] || [ -d "$cgroot/units/$unit" ]; then printf '/units/%s\n' "$unit"; fi
  ;;
 is-active)
  pid_alive "$unit"
  ;;
 stop)
  if [ -e "$state/hang-stop" ]; then sleep 60; exit 0; fi
  if pid_alive "$unit"; then
   pid=$(cat "$state/units/$unit.pid")
   kill -TERM "$pid" 2>/dev/null || true
   sleep .1
   kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$state/units/$unit.pid"
  # stop-leaves-populated simulates a scope/service whose cgroup stays busy
  # after the stop API call returns (the broker must fail closed on it).
  if [ ! -e "$state/stop-leaves-populated" ]; then
   printf 'populated 0\nfrozen 0\n' >"$cgroot/units/$unit/cgroup.events"
  fi
  ;;
 list-units)
  for f in "$state"/units/*.pid; do
   [ -e "$f" ] || continue
   u=$(basename "$f" .pid)
   pid_alive "$u" && printf '%s loaded active running fake\n' "$u"
  done
  ;;
 *) exit 2 ;;
esac
