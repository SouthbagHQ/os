+        }
+    }
+
+    #[test]
+    fn template_cursor_html_markdown_clipboard_image_deny() {
+        for replace in ["{{fixture}}", "prefix{{", "suffix}}", "cursor$|tail"] {
+            let mut item = literal();
+            if let MatchEffect::Text(text) = &mut item.effect { text.replace = replace.into(); }
+            assert!(check(&item).is_err());
+        }
+        for format in [TextFormat::Html, TextFormat::Markdown] {
+            let mut item = literal();
+            if let MatchEffect::Text(text) = &mut item.effect { text.format = format; }
+            assert!(check(&item).is_err());
+        }
+        let mut item = literal();
+        if let MatchEffect::Text(text) = &mut item.effect { text.force_mode = Some(TextInjectMode::Clipboard); }
+        assert!(check(&item).is_err());
+        item.effect = MatchEffect::Image(ImageEffect::default());
+        assert!(check(&item).is_err());
+        item.effect = MatchEffect::None;
+        assert!(check(&item).is_err());
+    }
+
+    fn kevin_rule() -> Match {
+        Match { cause: MatchCause::Trigger(TriggerCause {
+                triggers: vec![KEVIN_RULE_TRIGGER.into()], ..Default::default() }),
+            effect: MatchEffect::Text(TextEffect {
+                replace: KEVIN_RULE_REPLACE.into(), ..Default::default() }),
+            ..Default::default() }
+    }
+    fn check_store(items: Vec<Match>) -> Result<()> {
+        struct Store(Vec<Match>);
+        impl MatchStore for Store {
+            fn loaded_paths(&self) -> Vec<String> { vec!["only".into()] }
+            fn query(&self, _: &[String]) -> MatchSet<'_> {
+                MatchSet { matches: self.0.iter().collect(), global_vars: vec![] }
+            }
+        }
+        validate_store(&Store(items))
+    }
+
+    #[test]
+    fn exact_pinned_rule_and_dormant_empty_pass() {
+        assert!(check_store(vec![]).is_ok());
+        assert!(check_store(vec![kevin_rule()]).is_ok());
+    }
+
+    #[test]
+    fn any_deviation_from_the_pinned_rule_denies() {
+        // Different trigger spelling, extra trigger, word boundaries, case
+        // propagation, different replacement, clipboard mode: all deny.
+        for trigger in [":kevin", "Kevin", "kevin "] {
+            let mut item = kevin_rule();
+            item.cause = MatchCause::Trigger(TriggerCause {
+                triggers: vec![trigger.into()], ..Default::default() });
+            assert!(check_store(vec![item]).is_err(), "trigger {trigger:?} must deny");
+        }
+        let mut item = kevin_rule();
+        item.cause = MatchCause::Trigger(TriggerCause {
+            triggers: vec![KEVIN_RULE_TRIGGER.into(), "kevin2".into()], ..Default::default() });
+        assert!(check_store(vec![item]).is_err());
+        for (left, right, propagate) in [(true, false, false), (false, true, false), (false, false, true)] {
+            let mut item = kevin_rule();
+            item.cause = MatchCause::Trigger(TriggerCause {
+                triggers: vec![KEVIN_RULE_TRIGGER.into()], left_word: left,
+                right_word: right, propagate_case: propagate, ..Default::default() });
+            assert!(check_store(vec![item]).is_err());
+        }
+        let mut item = kevin_rule();
+        item.effect = MatchEffect::Text(TextEffect { replace: "kevin".into(), ..Default::default() });
+        assert!(check_store(vec![item]).is_err());
+        // A second generic literal rule, even a valid one, denies.
+        assert!(check_store(vec![kevin_rule(), literal()]).is_err());
+        // Duplicate copies of the pinned rule deny.
+        assert!(check_store(vec![kevin_rule(), kevin_rule()]).is_err());
+    }
+
+    #[test]
+    fn regex_none_and_empty_triggers_deny() {
+        let mut item = literal();
+        item.cause = MatchCause::None;
+        assert!(check(&item).is_err());
+        item.cause = MatchCause::Regex(RegexCause { regex: ".*".into() });
+        assert!(check(&item).is_err());
+        for triggers in [vec![], vec![String::new()], vec!["ok".into(), String::new()]] {
+            item.cause = MatchCause::Trigger(TriggerCause { triggers, ..Default::default() });
+            assert!(check(&item).is_err());
+        }
+    }
+}
