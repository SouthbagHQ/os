new file mode 100644
index 0000000..ac13f52
--- /dev/null
+++ b/espanso-engine/src/terminal_gate.rs
@@ -0,0 +1,205 @@
+//! Unwired source-only generation policy. This module opens nothing and
+//! authorizes no device. Admission drained is not unit/FD/driver cleanup.
+//! A permit is not permission to emit after stop: callers need per-batch
+//! checks and an external bounded stop for in-flight or blocked operations.
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StopReason { InputUncertain, OutputUncertain, MonitorLost, ExplicitStop, PolicyFault }
+
+#[derive(Debug)]
+struct State { generation: u64, reason: Option<StopReason>, in_flight: usize, wake_tx: Option<crossbeam::channel::Sender<()>> }
+
+#[derive(Clone, Debug)]
+pub struct TerminalGate { state: Arc<Mutex<State>>, wake_rx: crossbeam::channel::Receiver<()> }
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StopState {
+    pub reason: Option<StopReason>,
+    pub admissions_in_flight: usize,
+}
+impl StopState {
+    pub fn admission_drained(&self) -> bool { self.reason.is_some() && self.admissions_in_flight == 0 }
+}
+
+#[derive(Debug)]
+pub struct Admission { gate: TerminalGate, generation: u64 }
+
+impl TerminalGate {
+    pub fn new(generation: u64) -> Self {
+        let (tx, rx) = crossbeam::channel::bounded(0);
+        Self { state: Arc::new(Mutex::new(State { generation, reason: None, in_flight: 0, wake_tx: Some(tx) })), wake_rx: rx }
+    }
+
+    // Lock poison never permits output or silently recovers the generation.
+    fn state(&self) -> std::sync::MutexGuard<'_, State> {
+        match self.state.lock() {
+            Ok(state) => state,
+            Err(poisoned) => {
+                let mut state = poisoned.into_inner();
+                state.reason = Some(StopReason::PolicyFault);
+                state.wake_tx.take();
+                state
+            }
+        }
+    }
+
+    pub fn admit(&self, generation: u64) -> Option<Admission> {
+        let mut state = self.state();
+        if state.reason.is_some() || state.generation != generation { return None; }
+        state.in_flight = match state.in_flight.checked_add(1) {
+            Some(count) => count,
+            None => { state.reason = Some(StopReason::PolicyFault);
+                state.wake_tx.take(); return None; }
+        };
+        Some(Admission { gate: self.clone(), generation })
+    }
+
+    pub fn request_stop(&self, reason: StopReason) -> StopState {
+        let mut state = self.state();
+        if state.reason.is_none() { state.reason = Some(reason); }
+        // Disconnect broadcasts readiness to every receiver clone, even if
+        // stop happened before registration. Never a consumable one-shot token.
+        state.wake_tx.take();
+        StopState { reason: state.reason, admissions_in_flight: state.in_flight }
+    }
+
+    pub(crate) fn wake_receiver(&self) -> &crossbeam::channel::Receiver<()> { &self.wake_rx }
+
+    // The single generation this gate admits. Broker-supplied in the wired
+    // worker; there is no setter and no rearm.
+    pub fn generation(&self) -> u64 { self.state().generation }
+
+    pub fn status(&self) -> StopState {
+        let state = self.state();
+        StopState { reason: state.reason, admissions_in_flight: state.in_flight }
+    }
+}
+impl Admission {
+    // This is a logical recheck, NOT an atomic boundary with an output syscall.
+    pub fn still_current(&self) -> bool {
+        let state = self.gate.state();
+        state.reason.is_none() && state.generation == self.generation
+    }
+}
+impl Drop for Admission {
+    fn drop(&mut self) {
+        let mut state = self.gate.state();
+        match state.in_flight.checked_sub(1) {
+            Some(count) => state.in_flight = count,
+            None => state.reason = Some(StopReason::PolicyFault),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    #[test]
+    fn backlog_and_stale_or_future_generation_are_denied() {
+        let gate=TerminalGate::new(7);
+        assert!(gate.admit(6).is_none());
+        assert!(gate.admit(8).is_none());
+        assert!(!gate.status().admission_drained());
+        assert!(gate.request_stop(StopReason::InputUncertain).admission_drained());
+        for _ in 0..100 { assert!(gate.admit(7).is_none()); }
+    }
+    #[test]
+    fn active_permit_does_not_turn_stop_request_into_completion() {
+        let gate=TerminalGate::new(7);
+        let permit=gate.admit(7).unwrap();
+        assert!(permit.still_current());
+        assert!(!gate.request_stop(StopReason::OutputUncertain).admission_drained());
+        assert!(!permit.still_current());
+        drop(permit);
+        assert!(gate.status().admission_drained());
+    }
+    #[test]
+    fn first_stop_reason_is_retained_without_rearm() {
+        let gate=TerminalGate::new(7);
+        gate.request_stop(StopReason::MonitorLost);
+        for _ in 0..100 {
+            assert_eq!(gate.request_stop(StopReason::ExplicitStop).reason,Some(StopReason::MonitorLost));
+            assert!(gate.admit(7).is_none());
+        }
+    }
+    #[test]
+    fn independent_permits_finish_only_their_own_admission() {
+        let gate=TerminalGate::new(7);
+        let first=gate.admit(7).unwrap();
+        let second=gate.admit(7).unwrap();
+        gate.request_stop(StopReason::ExplicitStop);
+        drop(first);
+        assert_eq!(gate.status().admissions_in_flight,1);
+        assert!(!gate.status().admission_drained());
+        drop(second);
+        assert!(gate.status().admission_drained());
+    }
+    #[test]
+    fn blocked_synthetic_output_needs_external_completion() {
+        let gate=TerminalGate::new(7);
+        let child_gate=gate.clone();
+        let (entered_tx,entered_rx)=mpsc::channel();
+        let (release_tx,release_rx)=mpsc::channel();
+        let child=std::thread::spawn(move || {
+            let permit=child_gate.admit(7).unwrap();
+            entered_tx.send(()).unwrap();
+            release_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+            assert!(!permit.still_current());
+        });
+        entered_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert!(!gate.request_stop(StopReason::InputUncertain).admission_drained());
+        assert!(gate.admit(7).is_none());
+        release_tx.send(()).unwrap();
+        child.join().unwrap();
+        assert!(gate.status().admission_drained());
+    }
+    #[test]
+    fn poisoned_policy_denies_instead_of_recovering_permission() {
+        let gate=TerminalGate::new(7);
+        let child_gate=gate.clone();
+        assert!(std::thread::spawn(move || {
+            let _held=child_gate.state.lock().unwrap();
+            panic!("inert poison fixture");
+        }).join().is_err());
+        assert!(gate.admit(7).is_none());
+        assert_eq!(gate.status().reason,Some(StopReason::PolicyFault));
+    }
+    #[test]
+    fn admission_counter_overflow_is_terminal() {
+        let gate=TerminalGate::new(7);
+        gate.state().in_flight=usize::MAX;
+        assert!(gate.admit(7).is_none());
+        assert_eq!(gate.status().reason,Some(StopReason::PolicyFault));
+        assert!(!gate.status().admission_drained());
+    }
+    #[test]
+    fn racing_admission_is_visible_or_denied_after_stop_returns() {
+        // Enumerate many real scheduling interleavings, not a proof of driver
+        // ordering. The lock only linearizes policy admission and stop.
+        for _ in 0..200 {
+            let gate=TerminalGate::new(7);
+            let start=Arc::new(std::sync::Barrier::new(2));
+            let child_gate=gate.clone();
+            let child_start=start.clone();
+            let child=std::thread::spawn(move || {
+                child_start.wait();
+                child_gate.admit(7)
+            });
+            start.wait();
+            gate.request_stop(StopReason::ExplicitStop);
+            let permit=child.join().unwrap();
+            assert!(gate.admit(7).is_none());
+            if let Some(permit)=permit {
+                assert!(!permit.still_current());
+                assert_eq!(gate.status().admissions_in_flight,1);
+                drop(permit);
+            }
+            assert!(gate.status().admission_drained());
+        }
+    }
+
+}
