+// Shared terminal input for the output side, implemented by the worker
+// around the single espanso_engine::terminal_gate::TerminalGate. One object
+// per worker generation, shared by detector, funnel, engine and injector.
+#[cfg(feature = "southbag-inject-only")]
+pub trait TerminalSignal: Send + Sync {
+    fn is_terminal(&self) -> bool;
+    // Checked-write failure at the point of loss: marks the shared gate
+    // OutputUncertain so the whole worker generation inhibits.
+    fn mark_output_uncertain(&self);
