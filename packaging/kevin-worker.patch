+    // already-open /dev/uinput fd. This never opens a path itself; the fd IS
+    // the output grant. The device name comes from the shared Rust constant
+    // so the detector excludes this synthetic device from any input grant.
+    pub fn from_granted_fd(fd: i32, name: &str, phys: &str) -> Result<UInputDevice> {
+        if fd < 0 || unsafe { libc::fcntl(fd, libc::F_GETFD) } < 0 {
+            return Err(UInputDeviceError::Open().into());
+        }
+        // Own the fd only while validating; on failure close it (fail closed).
+        let fd = scopeguard::guard(fd, |fd| unsafe { close(fd); });
+
+        // The grant MUST be O_WRONLY|O_NONBLOCK (broker contract): every
+        // checked write must fail closed with EWOULDBLOCK rather than hang
+        // the injector indefinitely on output.
+        let flags = unsafe { libc::fcntl(*fd, libc::F_GETFL) };
+        if flags < 0
+            || flags & libc::O_ACCMODE != libc::O_WRONLY
+            || flags & libc::O_NONBLOCK == 0
+        {
+            return Err(UInputDeviceError::BlockingGrantDenied().into());
+        }
+
+        // Validate the generation phys binding before any setup ioctl: it
+        // must be a nonempty NUL-free string ("southbag:<generation>").
+        let phys = CString::new(phys).map_err(|_| UInputDeviceError::DevicePhys())?;
+        if phys.as_bytes().is_empty() {
+            return Err(UInputDeviceError::DevicePhys().into());
+        }
+
+        // Enable keyboard events
+        if unsafe { ioctl(*fd, ui_set_evbit(), EV_KEY as c_uint) } != 0 {
+            return Err(UInputDeviceError::KeyEVBit().into());
+        }
+
+        // Register all keycodes
+        for key_code in 0..256 {
+            if unsafe { ioctl(*fd, ui_set_keybit(), key_code) } != 0 {
+                return Err(UInputDeviceError::KeyBit().into());
+            }
+        }
