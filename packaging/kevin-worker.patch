+
+// Fail-closed per-key output check. A terminal signal stops ANY further
+// emission, including inside an already admitted key batch or delay loop.
+// This is a logical recheck, never a no-more-effects guarantee for a write
+// already in flight; the broker owns the bounded external stop.
+#[cfg(feature = "southbag-inject-only")]
+pub fn ensure_output_current(signal: &dyn TerminalSignal) -> Result<()> {
+    if signal.is_terminal() {
+        anyhow::bail!("terminal state observed; refusing further output");
+    }
+    Ok(())
+}
