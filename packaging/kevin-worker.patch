+/* Checked emission used by the inject-only worker's gated send_key path.
+ * No retry: partial output is uncertain, never safe to replay blindly.
+ * Caller terminally inhibits the generation on any -1 result.
+ */
+#include <linux/input.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+
+static int checked_record(int fd, unsigned short type, unsigned short code, int value) {
+    struct input_event event;
+    memset(&event, 0, sizeof(event));
+    event.type = type;
+    event.code = code;
+    event.value = value;
+    ssize_t result = write(fd, &event, sizeof(event));
+    if (result < 0) return -1; /* preserve writer errno */
+    if ((size_t)result != sizeof(event)) {
+        errno = EIO; /* includes short, zero, or impossible oversize result */
+        return -1;
+    }
+    return 0;
+}
+
+int southbag_checked_uinput_emit(int fd, unsigned int code, int pressed) {
+    if (code > 255 || (pressed != 0 && pressed != 1)) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (checked_record(fd, EV_KEY, (unsigned short)code, pressed) != 0) return -1;
+    return checked_record(fd, EV_SYN, SYN_REPORT, 0);
+}
