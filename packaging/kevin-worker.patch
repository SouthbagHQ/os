+        // Bind the sysfs phys to the worker generation BEFORE creating the
+        // device, so the created node appears with the binding already set.
+        if unsafe { set_uinput_phys(*fd, phys.as_ptr()) } != 0 {
+            return Err(UInputDeviceError::DevicePhys().into());
+        }
