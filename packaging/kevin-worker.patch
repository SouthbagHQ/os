+// EVIOCGNAME for a 256-byte buffer: _IOC(_IOC_READ, 'E', 0x06, 256)
+// = 2<<30 | 256<<16 | 0x45<<8 | 0x06 = 0x81004506 (see linux/input.h).
+// Failing the query denies the grant; a name is never trusted as identity.
+#[cfg(feature = "southbag-inject-only")]
+const EVIOCGNAME_256: std::os::raw::c_ulong = 0x81004506;
+
+#[cfg(feature = "southbag-inject-only")]
+fn read_device_name(fd: i32) -> Result<String> {
+    let mut buffer = [0u8; 256];
+    let request = EVIOCGNAME_256;
+    let result = unsafe { libc::ioctl(fd, request, buffer.as_mut_ptr()) };
+    if result < 0 {
+        return Err(DeviceError::InvalidGrant().into());
+    }
+    let end = buffer.iter().position(|b| *b == 0).unwrap_or(buffer.len());
+    Ok(String::from_utf8_lossy(&buffer[..end]).into_owned())
+}
+
+#[cfg(all(test, feature = "southbag-inject-only"))]
+mod granted_fd_tests {
+    use super::*;
+    use std::os::unix::io::AsRawFd;
+
+    #[test]
+    fn eviocgname_request_matches_linux_uapi_value() {
+        // linux/input.h: EVIOCGNAME(len) = _IOC(_IOC_READ, 'E', 0x06, len);
+        // _IOC_READ=2, 'E'=0x45: 2<<30 | 256<<16 | 0x45<<8 | 0x06.
+        assert_eq!(super::EVIOCGNAME_256, (2u64 << 30) | (256u64 << 16) | (0x45u64 << 8) | 0x06);
+    }
+
+    #[test]
+    fn non_evdev_fd_is_denied_and_closed_exactly_once() {
+        // A pipe is a valid fd but not an evdev device: the grant must be
+        // rejected and ownership released (closing the write end observes the
+        // read end gone if and only if the grant fd was closed once).
+        let mut fds = [0i32; 2];
+        assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+        let (read_fd, write_fd) = (fds[0], fds[1]);
+        // Avoid constructing a real Keymap (needs xkb); validate only the fd
+        // pre-checks here: fcntl validity + capability ioctl deny path.
+        assert!(unsafe { libc::fcntl(read_fd, libc::F_GETFD) } >= 0);
+        assert_eq!(unsafe { is_keyboard_or_mouse(read_fd) }, 0);
+        unsafe {
+            libc::close(read_fd);
+            libc::close(write_fd);
+        }
+    }
+
+    #[test]
+    fn read_device_name_denies_non_device_fd() {
+        let mut fds = [0i32; 2];
+        assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+        assert!(read_device_name(fds[0]).is_err());
+        unsafe {
+            libc::close(fds[0]);
+            libc::close(fds[1]);
+        }
+    }
+
+    #[test]
+    fn synthetic_output_name_constant_is_the_exact_uinput_setup_name() {
+        assert_eq!(espanso_info::SOUTHBAG_UINPUT_DEVICE_NAME, "Espanso virtual device");
+    }
+
+    #[test]
+    fn device_from_granted_fd_denies_pipe_before_keymap_use() {
+        // from_granted_fd must reject a nonblocking pipe at the capability
+        // check, before any keymap state is created. A real xkb keymap is
+        // used.
+        let mut fds = [0i32; 2];
+        assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+        let flags = unsafe { libc::fcntl(fds[0], libc::F_GETFL) };
+        assert!(flags >= 0);
+        assert_eq!(unsafe { libc::fcntl(fds[0], libc::F_SETFL, flags | libc::O_NONBLOCK) }, 0);
+        let context = crate::evdev::context::Context::new().expect("xkb context");
+        let keymap = crate::evdev::keymap::Keymap::new(&context, None).expect("xkb keymap");
+        let result = Device::from_granted_fd(fds[0], "grant-token".into(), &keymap);
+        // Passed the O_NONBLOCK gate; denied at the capability check.
+        assert!(matches!(
+            result.err().expect("grant must be denied").downcast_ref::<DeviceError>(),
+            Some(DeviceError::InvalidDevice(_))
+        ));
+        // The guard closed the granted read fd exactly once.
+        assert_eq!(unsafe { libc::fcntl(fds[0], libc::F_GETFD) }, -1);
+        unsafe { libc::close(fds[1]) };
+    }
+
+    #[test]
+    fn blocking_grant_is_denied_before_evdev_or_keymap_access() {
+        // A granted fd WITHOUT O_NONBLOCK is denied at adoption with
+        // BlockingGrantDenied - before the evdev capability ioctl and before
+        // any keymap state - because Device::read drains until EWOULDBLOCK
+        // and a blocking fd can hang on the second read of a finite batch.
+        let mut fds = [0i32; 2];
+        assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+        let context = crate::evdev::context::Context::new().expect("xkb context");
+        let keymap = crate::evdev::keymap::Keymap::new(&context, None).expect("xkb keymap");
+        let result = Device::from_granted_fd(fds[0], "grant-token".into(), &keymap);
+        assert!(matches!(
+            result.err().expect("grant must be denied").downcast_ref::<DeviceError>(),
+            Some(DeviceError::BlockingGrantDenied())
+        ));
+        // Denial closes the grant exactly once.
+        assert_eq!(unsafe { libc::fcntl(fds[0], libc::F_GETFD) }, -1);
+        unsafe { libc::close(fds[1]) };
+    }
+}
