+++ b/espanso/src/cli/worker/grants.rs
@@ -0,0 +1,216 @@
+// Broker grant contract for the Southbag inject-only worker (candidate).
+//
+// The root broker spawns this worker with already-open, already-qualified
+// file descriptors and describes them through a fixed environment contract.
+// This module only PARSES and VALIDATES that contract; it can reject a
+// bundle, never authorize one. Missing, malformed, or inconsistent bundles
+// fail closed: the worker refuses to start. See SOUTHBAG-WORKER-CONTRACT.md.
+//
+// Contract (all four required):
+//   SOUTHBAG_WORKER_GENERATION  decimal u64 > 0; binds every grant and the
+//                               shared terminal gate to one generation.
+//   SOUTHBAG_INPUT_GRANTS       comma-separated "fd=token" entries, at least
+//                               one; fds and tokens each unique; token is
+//                               [A-Za-z0-9._:-]+ (opaque broker identity).
+//   SOUTHBAG_MONITOR_FD         one fd: broker monitor-loss channel.
+//   SOUTHBAG_UINPUT_FD          one fd: open /dev/uinput for the virtual
+//                               output device.
+use anyhow::{bail, Result};
+use espanso_detect::evdev::{InputGrant, MonitorGrant};
+use std::os::unix::io::RawFd;
+
+pub const GENERATION_ENV: &str = "SOUTHBAG_WORKER_GENERATION";
+pub const INPUT_GRANTS_ENV: &str = "SOUTHBAG_INPUT_GRANTS";
+pub const MONITOR_FD_ENV: &str = "SOUTHBAG_MONITOR_FD";
+pub const UINPUT_FD_ENV: &str = "SOUTHBAG_UINPUT_FD";
+
+pub struct GrantBundle {
+    pub generation: u64,
+    pub inputs: Vec<InputGrant>,
+    pub monitor: MonitorGrant,
+    pub uinput_fd: RawFd,
+}
+
+pub fn from_env() -> Result<GrantBundle> {
+    parse(&|name| std::env::var(name).ok())
+}
+
+fn fd_is_open(fd: RawFd) -> bool {
+    fd >= 0 && unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0
+}
+
+fn valid_token(token: &str) -> bool {
+    !token.is_empty()
+        && token
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | ':' | '-'))
+}
+
+// Env lookup is injected so tests never mutate process-wide environment.
+pub(crate) fn parse(get: &dyn Fn(&str) -> Option<String>) -> Result<GrantBundle> {
+    let generation_raw = get(GENERATION_ENV).ok_or_else(|| anyhow::anyhow!("missing {GENERATION_ENV}"))?;
+    let generation: u64 = generation_raw
+        .parse()
+        .ok()
+        .filter(|generation| *generation > 0)
+        .ok_or_else(|| anyhow::anyhow!("invalid {GENERATION_ENV}"))?;
+
+    let grants_raw = get(INPUT_GRANTS_ENV).ok_or_else(|| anyhow::anyhow!("missing {INPUT_GRANTS_ENV}"))?;
+    let mut inputs = Vec::new();
+    let mut seen_fds = std::collections::BTreeSet::new();
+    let mut seen_tokens = std::collections::BTreeSet::new();
+    for entry in grants_raw.split(',') {
+        let (fd_raw, token) = entry
+            .split_once('=')
+            .ok_or_else(|| anyhow::anyhow!("malformed entry in {INPUT_GRANTS_ENV}"))?;
+        if token.contains('=') || !valid_token(token) {
+            bail!("invalid token in {INPUT_GRANTS_ENV}");
+        }
+        let fd: RawFd = fd_raw
+            .parse()
+            .map_err(|_| anyhow::anyhow!("invalid fd in {INPUT_GRANTS_ENV}"))?;
+        if !fd_is_open(fd) {
+            bail!("unopen fd in {INPUT_GRANTS_ENV}");
+        }
+        if !seen_fds.insert(fd) || !seen_tokens.insert(token.to_string()) {
+            bail!("duplicate fd or token in {INPUT_GRANTS_ENV}");
+        }
+        inputs.push(InputGrant { fd, token: token.to_string(), generation });
+    }
+    if inputs.is_empty() {
+        bail!("{INPUT_GRANTS_ENV} must grant at least one device");
+    }
+
+    let monitor_fd: RawFd = get(MONITOR_FD_ENV)
+        .and_then(|value| value.parse().ok())
+        .filter(|fd| fd_is_open(*fd))
+    .ok_or_else(|| anyhow::anyhow!("missing or unopen {MONITOR_FD_ENV}"))?;
+    if seen_fds.contains(&monitor_fd) {
+        bail!("{MONITOR_FD_ENV} must not alias an input grant");
+    }
+
+    let uinput_fd: RawFd = get(UINPUT_FD_ENV)
+        .and_then(|value| value.parse().ok())
+        .filter(|fd| fd_is_open(*fd))
+        .ok_or_else(|| anyhow::anyhow!("missing or unopen {UINPUT_FD_ENV}"))?;
+    if seen_fds.contains(&uinput_fd) || uinput_fd == monitor_fd {
+        bail!("{UINPUT_FD_ENV} must not alias another grant");
+    }
+
+    Ok(GrantBundle {
+        generation,
+        inputs,
+        monitor: MonitorGrant { fd: monitor_fd },
+        uinput_fd,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::HashMap;
+
+    struct Fixture {
+        env: HashMap<String, String>,
+        fds: Vec<RawFd>,
+    }
+    impl Fixture {
+        fn new() -> Self {
+            // Four pipes: two input grants, monitor, uinput.
+            let mut fds = Vec::new();
+            for _ in 0..4 {
+                let mut pair = [0i32; 2];
+                assert_eq!(unsafe { libc::pipe(pair.as_mut_ptr()) }, 0);
+                fds.push(pair[0]);
+                fds.push(pair[1]);
+            }
+            let mut env = HashMap::new();
+            env.insert(GENERATION_ENV.to_string(), "7".to_string());
+            env.insert(
+                INPUT_GRANTS_ENV.to_string(),
+                format!("{}=kbd0,{}=kbd1", fds[0], fds[2]),
+            );
+            env.insert(MONITOR_FD_ENV.to_string(), format!("{}", fds[4]));
+            env.insert(UINPUT_FD_ENV.to_string(), format!("{}", fds[6]));
+            Self { env, fds }
+        }
+        fn parse(&self) -> Result<GrantBundle> {
+            parse(&|name| self.env.get(name).cloned())
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            for fd in self.fds.drain(..) {
+                unsafe { libc::close(fd) };
+            }
+        }
+    }
+
+    #[test]
+    fn complete_bundle_parses_with_bound_generation() {
+        let fixture = Fixture::new();
+        let bundle = fixture.parse().expect("valid bundle");
+        assert_eq!(bundle.generation, 7);
+        assert_eq!(bundle.inputs.len(), 2);
+        assert!(bundle.inputs.iter().all(|grant| grant.generation == 7));
+    }
+
+    #[test]
+    fn missing_or_zero_generation_denies() {
+        for generation in [None, Some("0"), Some("not-a-number"), Some("-1")] {
+            let mut fixture = Fixture::new();
+            match generation {
+                None => fixture.env.remove(GENERATION_ENV),
+                Some(value) => fixture.env.insert(GENERATION_ENV.to_string(), value.to_string()),
+            };
+            assert!(fixture.parse().is_err(), "generation {generation:?} must deny");
+        }
+    }
+
+    #[test]
+    fn malformed_empty_or_duplicate_grants_deny() {
+        let mut fixture = Fixture::new();
+        fixture.env.insert(INPUT_GRANTS_ENV.to_string(), String::new());
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.insert(INPUT_GRANTS_ENV.to_string(), format!("{}", fixture.fds[0]));
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.insert(
+            INPUT_GRANTS_ENV.to_string(),
+            format!("{}=dup,{}=dup", fixture.fds[0], fixture.fds[2]),
+        );
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.insert(
+            INPUT_GRANTS_ENV.to_string(),
+            format!("{}=a,{}=b", fixture.fds[0], fixture.fds[0]),
+        );
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.insert(INPUT_GRANTS_ENV.to_string(), format!("999999=nosuch"));
+        assert!(fixture.parse().is_err());
+    }
+
+    #[test]
+    fn aliased_monitor_or_uinput_denies() {
+        let mut fixture = Fixture::new();
+        fixture.env.insert(MONITOR_FD_ENV.to_string(), format!("{}", fixture.fds[0]));
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.insert(UINPUT_FD_ENV.to_string(), format!("{}", fixture.fds[2]));
+        assert!(fixture.parse().is_err());
+
+        let mut fixture = Fixture::new();
+        fixture.env.remove(MONITOR_FD_ENV);
+        assert!(fixture.parse().is_err());
+        let mut fixture = Fixture::new();
+        fixture.env.remove(UINPUT_FD_ENV);
+        assert!(fixture.parse().is_err());
+    }
+}
