diff --git a/espanso-detect/src/evdev/topology_guard.rs b/espanso-detect/src/evdev/topology_guard.rs
new file mode 100644
index 0000000..2d50ee1
--- /dev/null
+++ b/espanso-detect/src/evdev/topology_guard.rs
@@ -0,0 +1,189 @@
+// Source-only policy primitive. It neither discovers/trusts devices nor opens,
+// grants, starts or resumes anything. A caller must treat Unchanged as absence
+// of a newly observed change, NEVER as authorization. No operational wiring.
+use std::collections::BTreeSet;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Invalidation {
+    InvalidSnapshot,
+    GenerationChanged,
+    DeviceSetChanged,
+    DeviceEvent,
+    MonitorGap,
+    MonitorLost,
+    ReadFailure,
+    StreamOrder,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Observation {
+    // Even apparently benign add/remove/change signals invalidate. Do not
+    // silently extend a previous generation to a replacement device.
+    DeviceEvent,
+    MonitorGap,
+    MonitorLost,
+    ReadFailure,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Decision {
+    Unchanged,
+    Inhibit(Invalidation),
+}
+
+pub struct TopologyGuard {
+    generation: u64,
+    // Opaque tokens are supplied by a future privileged identity resolver.
+    // Token equality alone establishes no physical provenance or owner trust.
+    snapshot: BTreeSet<String>,
+    invalidated: Option<Invalidation>,
+    last_record: Option<u64>,
+}
+
+impl TopologyGuard {
+    pub fn observe_initial(generation: u64, tokens: &[String]) -> Self {
+        let snapshot: BTreeSet<String> = tokens.iter().cloned().collect();
+        let invalid = generation == 0 || tokens.is_empty()
+            || tokens.iter().any(|s| s.trim().is_empty())
+            || snapshot.len() != tokens.len();
+        Self { generation, snapshot,
+            invalidated: invalid.then_some(Invalidation::InvalidSnapshot),
+            last_record: None }
+    }
+
+    fn invalidate(&mut self, reason: Invalidation) -> Decision {
+        let first = *self.invalidated.get_or_insert(reason);
+        Decision::Inhibit(first)
+    }
+
+    pub fn reconcile(&mut self, generation: u64, tokens: &[String]) -> Decision {
+        if let Some(reason) = self.invalidated { return Decision::Inhibit(reason); }
+        if generation != self.generation {
+            return self.invalidate(Invalidation::GenerationChanged);
+        }
+        let observed: BTreeSet<String> = tokens.iter().cloned().collect();
+        if observed.len() != tokens.len() || observed != self.snapshot {
+            return self.invalidate(Invalidation::DeviceSetChanged);
+        }
+        Decision::Unchanged
+    }
+
+    // Abstract monitor-local record numbering, not Linux global uevent
+    // SEQNUM. Only synthetic tests use this; no operational source is wired.
+    // First cursor must be1; dropped/duplicate/out-of-order records deny.
+    pub fn reconcile_record(&mut self, cursor: u64, generation: u64,
+                            tokens: &[String]) -> Decision {
+        if let Some(reason) = self.invalidated { return Decision::Inhibit(reason); }
+        let expected = match self.last_record {
+            None => Some(1),
+            Some(last) => last.checked_add(1),
+        };
+        if expected != Some(cursor) {
+            return self.invalidate(Invalidation::StreamOrder);
+        }
+        self.last_record = Some(cursor);
+        self.reconcile(generation, tokens)
+    }
+
+    pub fn observe(&mut self, event: Observation) -> Decision {
+        self.invalidate(match event {
+            Observation::DeviceEvent => Invalidation::DeviceEvent,
+            Observation::MonitorGap => Invalidation::MonitorGap,
+            Observation::MonitorLost => Invalidation::MonitorLost,
+            Observation::ReadFailure => Invalidation::ReadFailure,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn tokens(values: &[&str]) -> Vec<String> {
+        values.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn invalid_snapshots_never_pass() {
+        for (generation, values) in [(0, vec!["a"]), (1, vec![]),
+            (1, vec![""]), (1, vec![" "]), (1, vec!["a", "a"])] {
+            let values = tokens(&values);
+            let mut guard = TopologyGuard::observe_initial(generation, &values);
+            assert_eq!(guard.reconcile(1, &tokens(&["a"])),
+                Decision::Inhibit(Invalidation::InvalidSnapshot));
+        }
+    }
+
+    #[test]
+    fn order_only_is_unchanged_not_authorized() {
+        let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a", "b"]));
+        assert_eq!(guard.reconcile(7, &tokens(&["b", "a"])), Decision::Unchanged);
+    }
+
+    #[test]
+    fn addition_removal_replacement_duplicate_all_invalidate() {
+        for values in [vec!["a"], vec!["a", "b", "c"], vec!["a", "c"],
+            vec!["a", "b", "b"], vec![]] {
+            let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a", "b"]));
+            assert_eq!(guard.reconcile(7, &tokens(&values)),
+                Decision::Inhibit(Invalidation::DeviceSetChanged));
+            assert_eq!(guard.reconcile(7, &tokens(&["a", "b"])),
+                Decision::Inhibit(Invalidation::DeviceSetChanged));
+        }
+    }
+
+    #[test]
+    fn new_generation_does_not_rearm_old_guard() {
+        let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+        for generation in [8, 7, 0] {
+            assert_eq!(guard.reconcile(generation, &tokens(&["a"])),
+                Decision::Inhibit(Invalidation::GenerationChanged));
+        }
+    }
+
+    #[test]
+    fn every_monitor_or_read_failure_invalidates_permanently() {
+        for event in [Observation::DeviceEvent, Observation::MonitorGap,
+            Observation::MonitorLost, Observation::ReadFailure] {
+            let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+            let result = guard.observe(event);
+            assert!(matches!(result, Decision::Inhibit(_)));
+            assert_eq!(guard.reconcile(7, &tokens(&["a"])), result);
+            assert_eq!(guard.observe(Observation::DeviceEvent), result);
+        }
+    }
+    #[test]
+    fn ordered_identical_records_never_grant_or_resume() {
+        let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+        for cursor in 1..=100 {
+            assert_eq!(guard.reconcile_record(cursor, 7, &tokens(&["a"])),
+                       Decision::Unchanged);
+        }
+        let invalid = guard.observe(Observation::MonitorLost);
+        assert_eq!(guard.reconcile_record(101, 7, &tokens(&["a"])), invalid);
+    }
+
+    #[test]
+    fn dropped_duplicate_out_of_order_records_invalidate() {
+        for cursor in [0, 1, 3, u64::MAX] {
+            let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+            assert_eq!(guard.reconcile_record(1, 7, &tokens(&["a"])),
+                       Decision::Unchanged);
+            assert_eq!(guard.reconcile_record(cursor, 7, &tokens(&["a"])),
+                       Decision::Inhibit(Invalidation::StreamOrder));
+            assert_eq!(guard.reconcile_record(2, 7, &tokens(&["a"])),
+                       Decision::Inhibit(Invalidation::StreamOrder));
+        }
+    }
+
+    #[test]
+    fn missing_initial_record_and_cursor_overflow_deny() {
+        let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+        assert_eq!(guard.reconcile_record(2, 7, &tokens(&["a"])),
+                   Decision::Inhibit(Invalidation::StreamOrder));
+        let mut guard = TopologyGuard::observe_initial(7, &tokens(&["a"]));
+        guard.last_record = Some(u64::MAX);
+        assert_eq!(guard.reconcile_record(0, 7, &tokens(&["a"])),
+                   Decision::Inhibit(Invalidation::StreamOrder));
+    }
+
+}
