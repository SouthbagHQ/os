+    // Build a Device from a broker-granted, already-open fd. This never opens
+    // a path: the fd IS the grant. Every check here can only reject the grant.
+    // The token is the broker's opaque identity for the device; it is used
+    // only for diagnostics, never to re-derive trust.
+    #[cfg(feature = "southbag-inject-only")]
+    pub fn from_granted_fd(
+        fd: std::os::unix::io::RawFd,
+        token: String,
+        keymap: &Keymap,
+    ) -> Result<Device> {
+        use std::os::unix::io::FromRawFd;
+        if fd < 0 || unsafe { libc::fcntl(fd, libc::F_GETFD) } < 0 {
+            return Err(DeviceError::InvalidGrant().into());
+        }
+        // Own the fd only after basic validity; on any later failure the
+        // guard drops the File, closing the grant (fail closed, no leak).
+        let file = scopeguard::guard(unsafe { File::from_raw_fd(fd) }, |file| drop(file));
+
+        // The grant MUST be nonblocking (broker opens inputs
+        // O_RDONLY|O_NONBLOCK|O_CLOEXEC): Device::read drains until
+        // EWOULDBLOCK, and a blocking fd can hang on the second read after
+        // a finite batch. Checked at adoption, before any evdev/keymap use.
+        let flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0 || flags & libc::O_NONBLOCK == 0 {
+            return Err(DeviceError::BlockingGrantDenied().into());
+        }
+
+        if unsafe { is_keyboard_or_mouse(file.as_raw_fd()) } == 0 {
+            return Err(DeviceError::InvalidDevice(token).into());
+        }
+
+        // Synthetic-output exclusion: never admit the worker's own virtual
+        // output device as an input source (feedback loop).
+        let name = read_device_name(file.as_raw_fd()).map_err(|_| DeviceError::InvalidGrant())?;
+        if name == espanso_info::SOUTHBAG_UINPUT_DEVICE_NAME {
+            return Err(DeviceError::SyntheticOutputExcluded().into());
+        }
+
+        let raw_state = unsafe { xkb_state_new(keymap.get_handle()) };
+        let state = scopeguard::guard(raw_state, |raw_state| unsafe {
+            xkb_state_unref(raw_state);
+        });
+        if raw_state.is_null() {
+            return Err(DeviceError::InvalidState(token.clone()).into());
+        }
+
+        Ok(Self {
+            path: token,
+            file: ScopeGuard::into_inner(file),
+            state: ScopeGuard::into_inner(state),
+        })
+    }
+
+    // Bounded liveness re-check for a granted device, run on each detector
+    // wake. Still not physical-identity proof; a failure only invalidates.
+    #[cfg(feature = "southbag-inject-only")]
+    pub fn check_live_grant(&self) -> Result<()> {
+        let fd = self.get_raw_fd();
+        if unsafe { libc::fcntl(fd, libc::F_GETFD) } < 0 {
+            return Err(DeviceError::InvalidGrant().into());
+        }
+        // O_NONBLOCK is re-checked: the fd owner can F_SETFL it away, and a
+        // blocking read drains forever instead of failing closed.
+        let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+        if flags < 0 || flags & libc::O_NONBLOCK == 0 {
+            return Err(DeviceError::InputStreamInvalidated.into());
+        }
+        if unsafe { is_keyboard_or_mouse(fd) } == 0 {
+            return Err(DeviceError::InputStreamInvalidated.into());
+        }
+        let name = read_device_name(fd).map_err(|_| DeviceError::InputStreamInvalidated)?;
+        if name == espanso_info::SOUTHBAG_UINPUT_DEVICE_NAME {
+            return Err(DeviceError::SyntheticOutputExcluded().into());
+        }
+        Ok(())
+    }
