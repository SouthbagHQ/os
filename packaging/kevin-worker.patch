+        // Register the virtual device with the exact shared name
+        let name = CString::new(name).map_err(|_| UInputDeviceError::DeviceSetup())?;
+        if unsafe { setup_uinput_device_named(*fd, name.as_ptr()) } != 0 {
+            return Err(UInputDeviceError::DeviceSetup().into());
+        }
