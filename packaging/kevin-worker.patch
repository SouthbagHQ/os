+        Match { cause: MatchCause::Trigger(TriggerCause {
+                triggers: vec!["fixture".into()], ..Default::default() }),
+            effect: MatchEffect::Text(TextEffect {
+                replace: "Fixture".into(), force_mode: Some(TextInjectMode::Keys),
+                ..Default::default() }), ..Default::default() }
+    }
+    fn check(item: &Match) -> Result<()> {
+        validate_set(MatchSet { matches: vec![item], global_vars: vec![] })
+    }
+
+    #[test]
+    fn production_app_provider_never_queries_desktop() {
+        let provider = app_info_provider();
+        let info = provider.get_info();
+        assert!(info.title.is_none() && info.exec.is_none() && info.class.is_none());
+    }
+
+    #[test]
+    fn exact_production_renderer_has_no_dynamic_extensions() {
+        use espanso_render::{Renderer, Template, Context, RenderOptions, RenderResult};
+        let renderer = renderer();
+        let literal = Template { body: "Finite café".into(), ..Default::default() };
+        assert!(matches!(renderer.render(&literal, &Context::default(), &RenderOptions::default()),
