+// EOF must not leave a dedicated worker silently using a partial input set.
+fn require_live_read_length(length: ssize_t) -> Result<()> {
+    if cfg!(feature = "southbag-inject-only") {
+        if length == 0 {
+            return Err(DeviceError::FailedReadNoSuchDevice.into());
+        }
+        if length > 0 && length as usize % std::mem::size_of::<input_event>() != 0 {
+            return Err(DeviceError::InputStreamInvalidated.into());
+        }
+    }
+    Ok(())
+}
+
+fn require_contiguous_event(event_type: u16, code: u16) -> Result<()> {
+    // linux/input-event-codes.h: EV_SYN=0, SYN_DROPPED=3. Lost events
+    // invalidate modifier/history assumptions. Never guess a resync or continue.
+    if cfg!(feature = "southbag-inject-only") && event_type == 0 && code == 3 {
+        return Err(DeviceError::InputStreamInvalidated.into());
+    }
+    Ok(())
+}
+
