new file mode 100644
index 0000000..bc55713
--- /dev/null
+++ b/espanso-detect/src/evdev/grant.rs
@@ -0,0 +1,38 @@
+// Broker-grant contract types for the Southbag inject-only detector.
+//
+// A grant is evidence the root broker already opened and qualified a device.
+// These types never open, discover or trust a path by themselves: an
+// InputGrant only wraps an already-open file descriptor plus the broker's
+// opaque identity token, and construction-time validation can only REJECT a
+// grant, never authorize one the broker did not intend. Tokens carry no
+// physical provenance by themselves; the broker owns device identity.
+use std::os::unix::io::RawFd;
+
+// One broker-granted input device: an already-open, broker-owned evdev fd
+// bound to the worker generation. The detector takes ownership of the fd.
+pub struct InputGrant {
+    pub fd: RawFd,
+    pub token: String,
+    pub generation: u64,
+}
+
+// Broker-owned monitor-loss channel (pipe or eventfd). ANY readiness or
+// hangup on this fd means the broker's topology monitor is gone or signals
+// loss; the detector treats it as terminal, never as input data.
+pub struct MonitorGrant {
+    pub fd: RawFd,
+}
+
+// Shared terminal input for the detector, implemented by the worker around
+// the single espanso_engine::terminal_gate::TerminalGate. One object per
+// worker generation, shared by detector, funnel, engine and injector.
+pub trait InputTerminalSignal: Send + Sync {
+    // The generation this signal admits. Grants bound to any other
+    // generation (including 0) must be rejected at construction.
+    fn generation(&self) -> u64;
+    fn is_terminal(&self) -> bool;
+    // Read-side loss: poll/read/stream/topology uncertainty on input.
+    fn mark_input_uncertain(&self);
+    // Monitor-loss channel fired or monitor fd failed.
+    fn mark_monitor_lost(&self);
+}
