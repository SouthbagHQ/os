+    #[test]
+    fn engine_unwind_drops_remote_and_unblocks_ui_as_error() {
+        // Channel-only lifecycle fixture. No display, notification, worker,
+        // device, credential or transport initialization.
+        let (remote, eventloop) = create(LinuxUIOptions {
