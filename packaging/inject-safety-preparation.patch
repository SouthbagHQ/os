index 0000000..e1642f2
--- /dev/null
+++ b/espanso/src/cli/worker/finite_profile.rs
@@ -0,0 +1,181 @@
+// Conservative source-only candidate contract: literal finite key injection.
+// This validates match data, never reads devices, renders content or activates.
+use anyhow::{bail, Result};
+use espanso_config::matches::{store::MatchStore, store::MatchSet, MatchCause,
+    MatchEffect, TextFormat, TextInjectMode};
+
+pub fn app_info_provider() -> Box<dyn espanso_info::AppInfoProvider> {
+    struct NoDesktopProbe;
+    impl espanso_info::AppInfoProvider for NoDesktopProbe {
+        fn get_info(&self) -> espanso_info::AppInfo {
+            espanso_info::AppInfo { title: None, exec: None, class: None }
+        }
+    }
+    Box::new(NoDesktopProbe)
+}
+
+pub fn renderer() -> impl espanso_render::Renderer {
+    espanso_render::create(Vec::new())
+}
+
+pub fn validate_configs(store: &dyn espanso_config::config::ConfigStore) -> Result<()> {
+    validate_backend(store.default().backend())?;
+    for config in store.configs() {
+        validate_backend(config.backend())?;
+    }
+    Ok(())
+}
+
+fn validate_backend(backend: espanso_config::config::Backend) -> Result<()> {
+    if !matches!(backend, espanso_config::config::Backend::Inject) {
+        bail!("inject-only profile forbids automatic or clipboard backend in any config");
+    }
+    Ok(())
+}
+
+pub fn validate_store(store: &dyn MatchStore) -> Result<()> {
+    validate_set(store.query(&store.loaded_paths()))
+}
+
+fn validate_set(set: MatchSet<'_>) -> Result<()> {
+    if !set.global_vars.is_empty() {
+        bail!("inject-only profile forbids global variables");
+    }
+    for item in set.matches {
+        match &item.cause {
+            MatchCause::Trigger(cause) if !cause.triggers.is_empty()
+                && cause.triggers.iter().all(|s| !s.is_empty()) => {}
+            _ => bail!("inject-only profile requires nonempty literal triggers"),
+        }
+        match &item.effect {
+            MatchEffect::Text(text) if text.vars.is_empty()
+                && matches!(text.format, TextFormat::Plain)
+                && !matches!(text.force_mode, Some(TextInjectMode::Clipboard))
+                && !text.replace.contains("{{") && !text.replace.contains("}}")
+                && !text.replace.contains("$|") => {}
+            _ => bail!("inject-only profile requires plain literal key replacement"),
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use espanso_config::matches::{Match, TriggerCause, TextEffect, Variable,
+        RegexCause, ImageEffect};
+
+    fn literal() -> Match {
+        Match { cause: MatchCause::Trigger(TriggerCause {
+                triggers: vec!["fixture".into()], ..Default::default() }),
+            effect: MatchEffect::Text(TextEffect {
+                replace: "Fixture".into(), force_mode: Some(TextInjectMode::Keys),
+                ..Default::default() }), ..Default::default() }
+    }
+    fn check(item: &Match) -> Result<()> {
+        validate_set(MatchSet { matches: vec![item], global_vars: vec![] })
+    }
+
+    #[test]
+    fn production_app_provider_never_queries_desktop() {
+        let provider = app_info_provider();
+        let info = provider.get_info();
+        assert!(info.title.is_none() && info.exec.is_none() && info.class.is_none());
+    }
+
+    #[test]
+    fn exact_production_renderer_has_no_dynamic_extensions() {
+        use espanso_render::{Renderer, Template, Context, RenderOptions, RenderResult};
+        let renderer = renderer();
+        let literal = Template { body: "Finite café".into(), ..Default::default() };
+        assert!(matches!(renderer.render(&literal, &Context::default(), &RenderOptions::default()),
+            RenderResult::Success(text) if text == "Finite café"));
+        for kind in ["shell", "script", "clipboard", "form", "choice", "date", "echo", "random"] {
+            let template = Template { body: "{{fixture}}".into(), vars: vec![espanso_render::Variable {
+                name: "fixture".into(), var_type: kind.into(), ..Default::default()
+            }], ..Default::default() };
+            assert!(matches!(renderer.render(&template, &Context::default(), &RenderOptions::default()),
+                RenderResult::Error(_)), "extension {kind} must not resolve");
+        }
+    }
+
+    #[test]
+    fn backend_must_be_explicit_key_injection_in_every_config() {
+        use espanso_config::config::Backend;
+        assert!(validate_backend(Backend::Inject).is_ok());
+        assert!(validate_backend(Backend::Auto).is_err());
+        assert!(validate_backend(Backend::Clipboard).is_err());
+    }
+
+    #[test]
+    fn complete_loaded_store_is_validated_not_just_active_group() {
+        struct Store { items: Vec<Match> }
+        impl MatchStore for Store {
+            fn loaded_paths(&self) -> Vec<String> { vec!["first".into(), "hidden".into()] }
+            fn query(&self, paths: &[String]) -> MatchSet<'_> {
+                assert_eq!(paths, &["first", "hidden"]);
+                MatchSet { matches: self.items.iter().collect(), global_vars: vec![] }
+            }
+        }
+        let mut invalid = literal();
+        invalid.effect = MatchEffect::Image(ImageEffect::default());
+        assert!(validate_store(&Store { items: vec![literal(), invalid] }).is_err());
+    }
+
+    #[test]
+    fn empty_dormant_and_literal_profiles_pass_validation_only() {
+        assert!(validate_set(MatchSet { matches: vec![], global_vars: vec![] }).is_ok());
+        assert!(check(&literal()).is_ok());
+        let mut item = literal();
+        item.effect = MatchEffect::Text(TextEffect {
+            replace: "Finite unicode: café".into(), ..Default::default() });
+        assert!(check(&item).is_ok());
+    }
+
+    #[test]
+    fn global_or_match_variables_deny_before_rendering() {
+        let variable = Variable { var_type: "shell".into(), ..Default::default() };
+        assert!(validate_set(MatchSet { matches: vec![], global_vars: vec![&variable] }).is_err());
+        for kind in ["shell", "script", "clipboard", "form", "choice", "date", "echo", "random", "unknown"] {
+            let mut item = literal();
+            if let MatchEffect::Text(text) = &mut item.effect {
+                text.vars.push(Variable { var_type: kind.into(), ..Default::default() });
+            }
+            assert!(check(&item).is_err(), "variable type {kind} must deny");
+        }
+    }
+
+    #[test]
+    fn template_cursor_html_markdown_clipboard_image_deny() {
+        for replace in ["{{fixture}}", "prefix{{", "suffix}}", "cursor$|tail"] {
+            let mut item = literal();
+            if let MatchEffect::Text(text) = &mut item.effect { text.replace = replace.into(); }
+            assert!(check(&item).is_err());
+        }
+        for format in [TextFormat::Html, TextFormat::Markdown] {
+            let mut item = literal();
+            if let MatchEffect::Text(text) = &mut item.effect { text.format = format; }
+            assert!(check(&item).is_err());
+        }
+        let mut item = literal();
+        if let MatchEffect::Text(text) = &mut item.effect { text.force_mode = Some(TextInjectMode::Clipboard); }
+        assert!(check(&item).is_err());
+        item.effect = MatchEffect::Image(ImageEffect::default());
+        assert!(check(&item).is_err());
+        item.effect = MatchEffect::None;
+        assert!(check(&item).is_err());
+    }
+
+    #[test]
+    fn regex_none_and_empty_triggers_deny() {
+        let mut item = literal();
+        item.cause = MatchCause::None;
+        assert!(check(&item).is_err());
+        item.cause = MatchCause::Regex(RegexCause { regex: ".*".into() });
+        assert!(check(&item).is_err());
+        for triggers in [vec![], vec![String::new()], vec!["ok".into(), String::new()]] {
+            item.cause = MatchCause::Trigger(TriggerCause { triggers, ..Default::default() });
+            assert!(check(&item).is_err());
+        }
+    }
+}
