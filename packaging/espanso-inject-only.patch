@@ -0,0 +1,32 @@
+// Southbag inject-only variant. No sockets, tools, environment or clipboard data.
+use crate::{Clipboard, ClipboardOperationOptions};
+use anyhow::{bail, Result};
+use std::path::Path;
+
+pub struct DisabledClipboard;
+impl Clipboard for DisabledClipboard {
+    fn get_text(&self, _: &ClipboardOperationOptions) -> Option<String> { None }
+    fn set_text(&self, _: &str, _: &ClipboardOperationOptions) -> Result<()> {
+        bail!("clipboard disabled in Southbag inject-only build")
+    }
+    fn set_image(&self, _: &Path, _: &ClipboardOperationOptions) -> Result<()> {
+        bail!("clipboard disabled in Southbag inject-only build")
+    }
+    fn set_html(&self, _: &str, _: Option<&str>, _: &ClipboardOperationOptions) -> Result<()> {
+        bail!("clipboard disabled in Southbag inject-only build")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn clipboard_is_unavailable_not_fake_success() {
+        let c = DisabledClipboard;
+        let options = ClipboardOperationOptions::default();
+        assert!(c.get_text(&options).is_none());
+        assert!(c.set_text("finite", &options).is_err());
+        assert!(c.set_html("<b>finite</b>", None, &options).is_err());
+        assert!(c.set_image(Path::new("unused"), &options).is_err());
+    }
+}
