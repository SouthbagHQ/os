+
+// ---------------- southbag-inject-only: evdev-native modifier sync ----------------
+// Without a compositor, the kernel itself is the ground truth for the initial
+// modifier state: EVIOCGKEY reports which keys are physically held on each
+// opened evdev device, and EVIOCGLED reports active lock LEDs (Caps Lock,
+// Num Lock). Assuming all-released here would be unsafe (a physically held
+// Shift/Ctrl/Alt at worker start would be misread until its next event), so
+// the inject-only build queries every opened device and ORs the results.
+#[cfg(feature = "southbag-inject-only")]
+mod evdev_initial_modifiers {
+    // Request codes computed as _IOC(_IOC_READ, 'E', nr, size); see linux/input.h.
+    pub const EVIOCGBIT_EVKEY_96: libc::c_ulong = (2 << 30) | (96 << 16) | (0x45 << 8) | 0x21;
+    pub const EVIOCGKEY_96: libc::c_ulong = (2 << 30) | (96 << 16) | (0x45 << 8) | 0x18;
+    pub const EVIOCGLED_8: libc::c_ulong = (2 << 30) | (8 << 16) | (0x45 << 8) | 0x19;
+    // Key codes from linux/input-event-codes.h
+    pub const KEY_LEFTCTRL: usize = 29;
+    pub const KEY_RIGHTCTRL: usize = 97;
+    pub const KEY_LEFTSHIFT: usize = 42;
+    pub const KEY_RIGHTSHIFT: usize = 54;
+    pub const KEY_LEFTALT: usize = 56;
+    pub const KEY_RIGHTALT: usize = 100;
+    pub const KEY_LEFTMETA: usize = 125;
+    pub const KEY_RIGHTMETA: usize = 126;
+    pub const KEY_CAPSLOCK: usize = 58;
+    pub const KEY_NUMLOCK: usize = 69;
+    pub const LED_CAPSL: usize = 1;
+    pub const LED_NUML: usize = 0;
+    pub const MODIFIER_KEYS: [usize; 8] = [
+        KEY_LEFTCTRL, KEY_RIGHTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT,
+        KEY_LEFTALT, KEY_RIGHTALT, KEY_LEFTMETA, KEY_RIGHTMETA,
+    ];
+
+    pub fn test_bit(bit: usize, buf: &[u8]) -> bool {
+        bit / 8 < buf.len() && buf[bit / 8] & (1 << (bit % 8)) != 0
+    }
+}
+
+// Without a compositor, the kernel itself is the ground truth for the initial
+// modifier state: EVIOCGKEY reports which keys are physically held on each
+// opened evdev device, and EVIOCGLED reports active lock LEDs (Caps Lock,
+// Num Lock). Fail-closed semantics: any ioctl failure on a modifier-capable
+// device is fatal, because skipping it could miss a physically held modifier;
+// devices that do not advertise modifier keys (mice) are skipped by
+// capability, not by failure. Hotplug note: the evdev source enumerates
+// devices only at init, and this query covers exactly that enumerated set, so
+// state and events always come from the same devices. A keyboard plugged in
+// later contributes neither events nor state (it is never read); a modifier
+// held on such a keyboard while typing on an enumerated one is a documented
+// known limit, not a misread of an observed device.
+#[cfg(feature = "southbag-inject-only")]
+fn evdev_modifiers_state(devices: &[Device]) -> Result<Option<sync::ModifiersState>> {
+    use evdev_initial_modifiers::*;
+
+    if devices.is_empty() {
+        return Ok(None);
+    }
+
+    let mut state = sync::ModifiersState {
+        ctrl: false,
+        alt: false,
+        shift: false,
+        caps_lock: false,
+        meta: false,
+        num_lock: false,
+    };
+    let mut modifier_devices = 0usize;
+
+    for device in devices {
+        let fd = device.get_raw_fd();
+        // 96 bytes cover KEY_MAX (0x2ff); 8 bytes cover LED_MAX (0x0f).
+        let mut caps_buf = [0u8; 96];
+        let caps_rc = unsafe { libc::ioctl(fd, EVIOCGBIT_EVKEY_96, caps_buf.as_mut_ptr()) };
+        if caps_rc < 0 {
+            // Cannot classify the device: fail closed, an unclassifiable input
+            // device might be a keyboard with held modifiers.
+            error!(
+                "southbag-inject-only: EVIOCGBIT(EV_KEY) failed on {}; refusing to guess initial modifier state",
+                device.get_path()
+            );
+            return Err(EVDEVSourceError::InitFailure().into());
+        }
+        let is_modifier_device =
+            MODIFIER_KEYS.iter().any(|&k| test_bit(k, &caps_buf))
+            || test_bit(KEY_CAPSLOCK, &caps_buf)
+            || test_bit(KEY_NUMLOCK, &caps_buf);
+        if !is_modifier_device {
+            continue;
+        }
+        modifier_devices += 1;
+
+        let mut key_buf = [0u8; 96];
+        let mut led_buf = [0u8; 8];
+        let key_rc = unsafe { libc::ioctl(fd, EVIOCGKEY_96, key_buf.as_mut_ptr()) };
+        let led_rc = unsafe { libc::ioctl(fd, EVIOCGLED_8, led_buf.as_mut_ptr()) };
+        if key_rc < 0 || led_rc < 0 {
+            error!(
+                "southbag-inject-only: EVIOCGKEY/EVIOCGLED failed on modifier-capable device {} (key_rc={}, led_rc={}); refusing to guess initial modifier state",
+                device.get_path(),
+                key_rc,
+                led_rc
+            );
+            return Err(EVDEVSourceError::InitFailure().into());
+        }
+        state.ctrl |= test_bit(KEY_LEFTCTRL, &key_buf) || test_bit(KEY_RIGHTCTRL, &key_buf);
+        state.shift |= test_bit(KEY_LEFTSHIFT, &key_buf) || test_bit(KEY_RIGHTSHIFT, &key_buf);
+        state.alt |= test_bit(KEY_LEFTALT, &key_buf) || test_bit(KEY_RIGHTALT, &key_buf);
+        state.meta |= test_bit(KEY_LEFTMETA, &key_buf) || test_bit(KEY_RIGHTMETA, &key_buf);
+        state.caps_lock |= test_bit(LED_CAPSL, &led_buf);
+        state.num_lock |= test_bit(LED_NUML, &led_buf);
+    }
+
+    info!(
+        "southbag-inject-only: initial modifier state from {} modifier-capable evdev device(s): {:?}",
+        modifier_devices, state
+    );
+    Ok(Some(state))
+}
